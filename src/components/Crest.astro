---
import { getEnv } from '../lib/page';
import { resultsDb } from '../lib/results/config';
import { logoMap, crestOf, type CrestSrc } from '../lib/results/logos';
import { skTeam } from '../lib/names';
/** Team crest when the team is linked, otherwise its initials in a badge (keeps rows aligned). `name` = feed name. */
interface Props { sp: number; name: string; size?: number }
const { sp, name, size = 22 } = Astro.props;
let c: CrestSrc | null = null;
try { c = crestOf(await logoMap(resultsDb(getEnv())), sp, name, size); } catch { /* no env (prerender) */ }
const ini = skTeam(name).replace(/\(.*?\)/g, '').split(/[\s-]+/).filter((w) => /^\p{L}/u.test(w)).slice(0, 2).map((w) => w[0]).join('').toUpperCase() || '•';
---
{c ? <img class="crest" src={c.src} srcset={c.srcset} width={size} height={size} alt="" loading="lazy" decoding="async" style={`width:${size}px;height:${size}px`} />
  : <span class="crest ini" style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.4)}px`} aria-hidden="true">{ini}</span>}
