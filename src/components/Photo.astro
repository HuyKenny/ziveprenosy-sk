---
import { photoFor, hasLarge } from '../lib/photos';
import { SPORT_BY_SLUG } from '../lib/sports';
/** Sport photo as <picture>: AVIF 480/800/1600 + JPEG fallback. Absolute-fill styling comes from the parent. */
interface Props { sport?: string; alt?: string; eager?: boolean; sizes?: string; seed?: number }
const { sport, alt = '', eager = false, sizes = '100vw', seed = 0 } = Astro.props;
const p = photoFor(sport, seed);
const altText = alt || `${SPORT_BY_SLUG.get(sport ?? '')?.name ?? 'Šport'} – ilustračné foto`;
const b = `/img/sport/${p.slug}`;
---
<picture>
  <source type="image/avif" srcset={`${b}-480.avif 480w, ${b}-640.avif 640w, ${b}-800.avif 800w${hasLarge(p.slug) ? `, ${b}-1600.avif 1600w` : ''}`} sizes={sizes} />
  <img src={`${b}-800.jpg`} alt={altText} width="800" height="450" loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : undefined} />
</picture>
