---
import type { Detail } from '../lib/results/afdata';
/** Match event pictogram. Cards are drawn as cards (colour + shape + label next to it, never colour alone). */
interface Props { kind: Detail['events'][number]['kind']; label: string }
const { kind, label } = Astro.props;
---
<span class:list={['evi', `evi-${kind}`]} title={label}>
  {kind === 'yellow' ? <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="3.5" width="10" height="15" rx="1.6" transform="rotate(8 12 11)" fill="#f2c230" stroke="#000" stroke-width="1.4"/></svg>
  : kind === 'red' ? <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="3.5" width="10" height="15" rx="1.6" transform="rotate(8 12 11)" fill="#e0372c" stroke="#000" stroke-width="1.4"/></svg>
  : kind === 'yellowred' ? <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="9.5" height="14" rx="1.5" transform="rotate(-8 9 10)" fill="#f2c230" stroke="#000" stroke-width="1.3"/><rect x="10" y="6" width="9.5" height="14" rx="1.5" transform="rotate(9 15 13)" fill="#e0372c" stroke="#000" stroke-width="1.3"/></svg>
  : kind === 'sub' ? <svg viewBox="0 0 24 24" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 20V6M4.5 9.5L8 6l3.5 3.5" stroke="#3fcf74"/><path d="M16 4v14M12.5 14.5L16 18l3.5-3.5" stroke="#ff5b4d"/></svg>
  : kind === 'pim' ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="6" width="17" height="12" rx="2" stroke="#ff8a3d"/><circle cx="12" cy="12" r="3.2" stroke="#ff8a3d"/><path d="M12 10.4V12l1 .8" stroke="#ff8a3d"/></svg>
  : kind === 'var' ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="12" rx="2"/><path d="M8 21h8M12 17v4M7.5 9l2 4 2-4M13.5 13l1.5-4 1.5 4M14 12h2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  : <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill={kind === 'own' ? '#ff5b4d' : '#fff'} stroke="#000" stroke-width="1.4"/><path d="M12 8.2l3.2 2.3-1.2 3.8h-4l-1.2-3.8z" fill="#111"/><path d="M12 8.2V3.4M15.2 10.5l4.6-1.5M14 14.3l2.8 3.9M10 14.3l-2.8 3.9M8.8 10.5L4.2 9" stroke="#111" stroke-width="1.2" fill="none"/>{kind === 'missed' ? <path d="M4 20L20 4" stroke="#ff5b4d" stroke-width="2.6" stroke-linecap="round"/> : null}{kind === 'pen' ? <text x="17" y="22" font-size="9" font-weight="900" fill="#ffd23f" stroke="#000" stroke-width=".6" font-family="Arial,sans-serif">P</text> : null}</svg>}
</span>
