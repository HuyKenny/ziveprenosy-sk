---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Faq from '../../components/Faq.astro';
import Ticket from '../../components/Ticket.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { breadcrumbLd, faqLd, BRAND, SITE } from '../../lib/seo';
import photos from '../../data/article-photos.json';
export const prerender = false;
const entry = await getEntry('clanky', Astro.params.slug!);
if (!entry) return Astro.rewrite('/404');
const { Content } = await render(entry);
// Feature photo (node ~/ai/apps/sportstreamy/scripts/article-photo.mjs with PHOTO_DIR/PHOTO_META, see README).
const photo = (photos as Record<string, { author: string; authorUrl: string; url: string; alt: string }>)[entry.id];
const img = photo ? `/img/clanky/${entry.id}-og.jpg` : undefined;
const { title, description, date, updated, faq, related } = entry.data;
const fmt = new Intl.DateTimeFormat('sk-SK', { day: 'numeric', month: 'long', year: 'numeric' });
const others = (await getCollection('clanky')).filter((a) => a.id !== entry.id);
const rel = [...(related ?? []).map((s) => others.find((a) => a.id === s)).filter((a) => !!a), ...others.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())]
  .filter((a, i, all) => all.indexOf(a) === i)
  .slice(0, 3);
const crumbs = [{ name: 'Domov', href: '/' }, { name: 'Články', href: '/clanky/' }, { name: title }];
const org = { '@type': 'Organization', name: BRAND, url: `${SITE}/o-nas/` };
const ld = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: title, description, datePublished: date.toISOString(), dateModified: (updated ?? date).toISOString(), inLanguage: 'sk', ...(img ? { image: SITE + img } : {}), author: org, publisher: org, mainEntityOfPage: `${SITE}/clanky/${entry.id}/` },
  breadcrumbLd(crumbs),
  ...(faq?.length ? [faqLd(faq)] : []),
];
---
<Base title={`${title} | ${BRAND}`} description={description} ld={ld} section="clanky" ttl={3600} image={img}>
  <div class="wrap">
    <Crumbs items={crumbs} />
    <div class="cols">
      <div>
        <article class="sec prose article">
          <h1>{title}</h1>
          <p class="muted meta">Redakcia {BRAND} · {updated ? `aktualizované ${fmt.format(updated)}` : fmt.format(date)}</p>
          {photo ? (
            <figure class="hero-img">
              <picture>
                <source type="image/avif" srcset={`/img/clanky/${entry.id}-800.avif 800w, /img/clanky/${entry.id}-1280.avif 1280w`} sizes="(min-width: 900px) 760px, 100vw" />
                <img src={`/img/clanky/${entry.id}-800.jpg`} srcset={`/img/clanky/${entry.id}-800.jpg 800w, /img/clanky/${entry.id}-1280.jpg 1280w`} sizes="(min-width: 900px) 760px, 100vw" width="1280" height="720" alt={photo.alt} fetchpriority="high" />
              </picture>
              <figcaption class="muted">Foto: <a href={photo.authorUrl} rel="noopener nofollow">{photo.author}</a> / <a href={photo.url} rel="noopener nofollow">Pexels</a></figcaption>
            </figure>
          ) : null}
          <Content />
          {faq?.length ? <><h2>Časté otázky</h2><Faq items={faq} /></> : null}
          <p class="art-cta"><a class="btn" href="/teraz-nazivo/"><span class="dot pulse"></span>Čo beží naživo</a> <a class="btn out" href="/program/">Program prenosov</a></p>
        </article>
        {rel.length ? (
          <section class="sec">
            <div class="sec-h"><h2>Ďalšie články</h2><a href="/clanky/">Všetky ›</a></div>
            <div class="art-list">{rel.map((a) => <a class="art-card" href={`/clanky/${a.id}/`}><b>{a.data.title}</b><span>{a.data.description}</span></a>)}</div>
          </section>
        ) : null}
      </div>
      <div class="side"><Ticket placement={`clanok-${entry.id}`} /></div>
    </div>
  </div>
</Base>
