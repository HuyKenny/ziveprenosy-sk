---
import Base from '../../layouts/Base.astro';
import LeagueList from '../../components/LeagueList.astro';
import Side from '../../components/Side.astro';
import Faq from '../../components/Faq.astro';
import Crumbs from '../../components/Crumbs.astro';
import Stick from '../../components/Stick.astro';
import Ticket from '../../components/Ticket.astro';
import { regPath } from '../../lib/url';
import Icon from '../../components/Icon.astro';
import Crest from '../../components/Crest.astro';
import Stage from '../../components/Stage.astro';
import MatchFacts from '../../components/MatchFacts.astro';
import EventIcon from '../../components/EventIcon.astro';
import { getEnv, view, sportCounts, leagues } from '../../lib/page';
import { hhmm, longDay, dayLabel, shortDay } from '../../lib/text';
import { matchTitle, matchPath, sportOf, goPath, sportPath, leaguePathOf, home, away, teamPath } from '../../lib/url';
import { teamOf, officialName } from '../../lib/teams';
import { goneMatchTarget } from '../../lib/redirects';
import Form from '../../components/Form.astro';
import { formOf } from '../../lib/results/store';
import { competitionSlug, leagueName, competitionOf } from '../../lib/competitions';
import { skClockShort } from '../../lib/names';
import { BONUS } from '../../lib/bonus';
import { breadcrumbLd, faqLd, sportsEventLd, clip, BRAND } from '../../lib/seo';
import { resultsConfig, resultsDb } from '../../lib/results/config';
import { rowByExt } from '../../lib/results/store';
import { asMatch, scoreText, detailText, isStale, detailOf, scorers, EVENT_LABELS, formMarks, formSummary } from '../../lib/results/view';
import { isFinal, isInPlay, statusLabel } from '../../lib/results/status';

export const prerender = false;
const id = Number((Astro.params.slug ?? '').split('-')[0]);
const env = getEnv();
const v = await view(env);
const now = Date.now();
// A stored result keeps the page alive after the match leaves the feed (instead of 410).
const rdb = resultsDb(env);
const r = id && rdb ? await rowByExt(rdb, id) : null;
const fresh = id ? [...v.live, ...v.recent, ...v.upcoming].find((x) => x.id === id) : undefined;
const m = fresh ?? (r ? asMatch(r) : undefined);
// An event that left the feed without a stored result: 301 to the club or the live overview instead of a dead 410.
if (!m && id) return Astro.redirect(goneMatchTarget(Astro.params.slug ?? ''), 301);
if (!m) {
  Astro.response.status = 404;
  Astro.response.headers.set('X-Robots-Tag', 'noindex');
}
const canonicalPath = m ? matchPath(m) : '';
if (m && Astro.url.pathname !== canonicalPath) return Astro.redirect(canonicalPath, 301);
const sport = m ? sportOf(m) : undefined;
const teamH = m ? teamOf(m.sp, m.h) : undefined;
const teamA = m && m.a ? teamOf(m.sp, m.a) : undefined;
const over = !!r && (isFinal(r.status) || r.status === 'unconfirmed' || r.status === 'cancelled');
const final = !!r && isFinal(r.status);
const state: 'live' | 'pre' | 'recent' = !m ? 'recent' : over ? 'recent' : r && isInPlay(r.status) ? 'live' : v.live.includes(m) ? 'live' : m.st > now ? 'pre' : 'recent';
const sc = r && r.status !== 'scheduled' ? scoreText(r) : state === 'live' ? m?.sc ?? null : null;
const detail = r ? detailText(r) : '';
const stale = r ? isStale(r, now, resultsConfig(env).staleMs) : false;
// Official club names (HC 05 Banská Bystrica, Vlci Žilina) for titles and text — what people type into Google.
const nh = m ? officialName(m.sp, m.h, home(m)) : '';
const na = m && m.a ? officialName(m.sp, m.a, away(m)) : '';
const title = m ? (m.a ? `${nh} – ${na}` : nh) : '';
const lgName = m ? leagueName(m.sp, m.lg) : '';
const pool = [...v.live, ...v.upcoming].filter((x) => m && x.id !== m.id);
const same = m ? pool.filter((x) => x.sp === m.sp && competitionSlug(x.sp, x.lg) === competitionSlug(m.sp, m.lg)).slice(0, 8) : [];
const watch = m?.stream ? (state === 'live' ? 'Pozerať naživo' : 'Pozerať prenos') : 'Živé štatistiky';
const goals = scorers(r ? detailOf(r) : null);
// Form of both teams before this match (finished matches in the shared results database).
const before = m ? Math.min(now, m.st) : now;
const fH = m && rdb ? formMarks(await formOf(rdb, m.sp, m.h, before), m.h) : [];
const fA = m && m.a && rdb ? formMarks(await formOf(rdb, m.sp, m.a, before), m.a) : [];
const formSentence = [fH.length ? `${nh} ${fH.length === 1 ? 'v poslednom zápase' : `v posledných ${fH.length} zápasoch`}: ${formSummary(fH)}.` : '', fA.length ? `${na}: ${formSummary(fA)}.` : ''].filter(Boolean).join(' ');
const isExtraliga = m ? competitionOf(m.sp, m.lg)?.id === 'slovenska-extraliga' : false;
const resultSentence = r && m ? (final
  ? `Zápas ${title} sa skončil ${sc ?? 'bez zverejneného skóre'}${r.status === 'aet' ? ' po predĺžení' : r.status === 'pen' ? (r.sport === 23 ? ' po nájazdoch' : ' po penaltách') : ''}${detail ? ` (${detail})` : ''}.`
  : r.status === 'cancelled' ? `Zápas ${title} bol zrušený.`
  : `Konečný výsledok zápasu ${title} zatiaľ nie je potvrdený.${sc ? ` Posledné známe skóre bolo ${sc}.` : ''}`) : '';
const faq = !m ? [] : over ? [
  { q: `Ako sa skončil zápas ${title}?`, a: `${resultSentence} Hralo sa ${longDay(m.st)} o ${hhmm(m.st)} (${lgName}).` },
  { q: 'Kde nájdem ďalšie výsledky?', a: 'V prehľade Výsledky alebo na stránke súťaže, kde sú aj ďalšie zápasy.' },
] : [
  { q: `Kde pozerať ${title} naživo?`, a: m.stream ? `Zápas sa vysiela naživo. Klikni na „Pozerať“, prihlás sa alebo sa bezplatne zaregistruj a prenos sa spustí. Noví hráči dostanú ${BONUS.line}.` : 'K tomuto zápasu nie je video (práva má televízia), k dispozícii sú však živé štatistiky a priebežné skóre.' },
  { q: `Kedy sa začína ${title}?`, a: `${longDay(m.st)} o ${hhmm(m.st)} slovenského času.` },
  { q: `Kto vysiela ${title}?`, a: m.stream ? 'Zápas je v ponuke živých prenosov Tipsport TV – po prihlásení ho pozeráš zadarmo. Televízne vysielanie závisí od držiteľa práv pre danú súťaž.' : 'Video k zápasu v našej ponuke nie je, práva má televízia. Naživo sleduješ priebežné skóre a štatistiky.' },
  ...(formSentence ? [{ q: 'Ako sú na tom tímy pred zápasom?', a: formSentence }] : []),
  { q: 'Je pozeranie zadarmo?', a: 'Pre registrovaných hráčov áno. Staviť si nemusíš, stávkovanie je dobrovoľné a len pre osoby od 18 rokov.' },
];
const crumbs = m && sport ? [{ name: 'Domov', href: '/' }, { name: `${sport.name} online`, href: sportPath(sport.slug) }, { name: lgName, href: leaguePathOf(m) }, { name: title }] : [];
const date = m ? shortDay(m.st).replace(/\s/g, '') : '';
const base = !m ? '' : final && sc ? `${title} ${sc} – výsledok ${date}` : over ? `${title} ${date} – výsledok` : [`${title}: ${lgName} online ${date}`, `${title} online ${date}`].find((t) => t.length <= 60) ?? `${title} naživo`;
const pageTitle = !m ? `Zápas sa skončil | ${BRAND}` : base.length <= 44 ? `${base} | ${BRAND}` : clip(base, 62);
const desc = !m ? '' : over ? clip(`${resultSentence} ${lgName}, ${longDay(m.st)}. Ďalšie zápasy a program súťaže.`, 158) : clip(`${isExtraliga ? 'Hokej extraliga: ' : ''}${title} (${lgName}) – ${state === 'live' ? 'práve sa hrá' : `${dayLabel(m.st, now).toLowerCase()} o ${hhmm(m.st)}`}. ${m.stream ? 'Živý prenos zadarmo po registrácii' : 'Živé štatistiky a priebežné skóre'}, bonus ${BONUS.amount}.`, 158);
---
{m && sport ? (
<Base title={pageTitle} description={desc} path={canonicalPath} ld={[sportsEventLd(m, r?.status, final && sc ? sc : undefined), breadcrumbLd(crumbs), faqLd(faq)]} section={sport.slug} ttl={over ? 3600 : state === 'live' ? 30 : 60} stick={!over}>
  <div class="wrap">
    <Crumbs items={crumbs} />
    <section class="head" style="padding-bottom:14px">
      <h1>{final && sc ? `${title} ${sc}` : over ? `${title} – výsledok` : m.stream ? `${title} naživo` : `${title}: živé skóre`}</h1>
    </section>
    <div class="cols">
      <div>
        <section class="scorecard sec" data-id={state === 'live' ? m.id : undefined}>
          <div class="sc-top"><a href={leaguePathOf(m)}>{lgName}</a><span>{sport.name} · {longDay(m.st)}</span></div>
          <div class="sc-mid">
            <div class="team"><Crest sp={m.sp} name={m.h} size={56} />{teamH ? <a href={teamPath(sport.slug, teamH.slug)}>{nh}</a> : nh}</div>
            <div>
              {sc ? <div class="big" data-s>{sc}</div> : <div class="big time">{hhmm(m.st)}</div>}
              <div class:list={['when', state === 'live' && 'l']}>{over && r ? statusLabel(r.status, r.sport) : state === 'live' ? (/^(Za|O) /.test(m.ti ?? '') ? <span data-t>{skClockShort(m.ti ?? '')}</span> : <><span class="dot pulse"></span> Naživo <span class="clk" data-t>{skClockShort(m.ti ?? '')}</span></>) : state === 'pre' ? dayLabel(m.st, now) : 'Odohrané'}</div>
            </div>
            {m.a ? <div class="team b"><Crest sp={m.sp} name={m.a} size={56} />{teamA ? <a href={teamPath(sport.slug, teamA.slug)}>{na}</a> : na}</div> : <div></div>}
          </div>
          {goals.h.length || goals.a.length || goals.redH || goals.redA ? (
            <div class="goals" aria-label="Góly a vylúčenia">
              {(['h', 'a'] as const).map((side) => (
                <ul class={side === 'a' ? 'b' : ''}>
                  {(side === 'h' ? goals.h : goals.a).map((e) => <li><EventIcon kind={e.kind} label={EVENT_LABELS[e.kind]} />{e.player} {e.min}{e.kind === 'pen' ? ' (pen.)' : e.kind === 'own' ? ' (vl.)' : ''}</li>)}
                  {Array.from({ length: side === 'h' ? goals.redH : goals.redA }, () => <li><EventIcon kind="red" label="Červená karta" />vylúčenie</li>)}
                </ul>
              ))}
            </div>
          ) : null}
          {detail ? <p class="detail">{detail}{stale ? ' · údaje sa môžu meškať' : ''}</p> : null}
          <div class="sc-cta">
            {over ? (<>
              <p>Zápas sa skončil<small>Pozri, čo sa hrá teraz – alebo si založ účet na ďalšie prenosy.</small></p>
              <span class="sc-btns"><a class="btn out" href="/teraz-nazivo/"><span class="dot pulse"></span>Práve naživo</a><a class="btn" href={regPath('detail-final')} rel="sponsored nofollow noopener" target="_blank"><Icon name="gift" />{BONUS.cta}</a></span>
            </>) : (<>
              <p>{m.stream ? BONUS.watch : 'Živé štatistiky a priebežné skóre'}<small>Nemáš účet? <a href={regPath('detail-new')} rel="sponsored nofollow noopener" target="_blank">{BONUS.line} ›</a> · Reklama · 18+</small></p>
              <a class="btn lg" data-watch href={goPath(m, 'detail')} rel="sponsored nofollow noopener" target="_blank"><Icon name={m.stream ? 'play' : 'spark'} />{watch}</a>
            </>)}
          </div>
        </section>

        {over || !m.stream ? null : <div class="sec"><Stage m={m} state={state} now={now} /></div>}

        <section class="sec">
          <dl class="facts">
            <div><dt>{over ? 'Hralo sa' : 'Začiatok'}</dt><dd>{hhmm(m.st)} · {shortDay(m.st)}</dd></div>
            <div><dt>Šport</dt><dd><a href={sportPath(sport.slug)}>{sport.name}</a></dd></div>
            <div><dt>Súťaž</dt><dd><a href={leaguePathOf(m)}>{lgName}</a></dd></div>
            <div><dt>{over ? 'Výsledok' : 'Prenos'}</dt><dd>{over ? (final && sc ? sc : statusLabel(r!.status, r!.sport)) : m.stream ? 'Video naživo' : 'Živé štatistiky'}</dd></div>
          </dl>
        </section>

        {fH.length || fA.length ? (
          <section class="sec">
            <div class="sec-h"><h2>Forma tímov</h2></div>
            <div class="comp">
              {fH.length ? <div class="form-row"><span><Crest sp={m.sp} name={m.h} size={22} />{nh}</span><Form marks={fH} label={`Forma ${nh}`} /></div> : null}
              {fA.length ? <div class="form-row"><span><Crest sp={m.sp} name={m.a} size={22} />{na}</span><Form marks={fA} label={`Forma ${na}`} /></div> : null}
            </div>
            <p class="muted" style="font-size:.84rem;margin-top:6px">Posledné odohrané zápasy, najnovší vľavo (V výhra, R remíza, P prehra).</p>
          </section>
        ) : null}
        {r ? <MatchFacts r={r} /> : null}

        {over ? null : <div class="sec"><Ticket placement="detail-bonus" wide /></div>}

        {same.length ? (<section class="sec"><div class="sec-h"><h2>Ďalšie zápasy · {lgName}</h2><a href={leaguePathOf(m)}>Všetko ›</a></div><LeagueList items={same} now={now} placement="detail-same" days showSport={false} /></section>) : null}

        <section class="sec prose">
          {over ? (<>
            <h2>{title} – výsledok</h2>
            <p>{resultSentence} Zápas sa hral {longDay(m.st)} o {hhmm(m.st)} v súťaži {lgName}. Ďalšie výsledky nájdeš v <a href="/vysledky/">prehľade výsledkov</a>, nadchádzajúce zápasy na stránke <a href={leaguePathOf(m)}>{lgName}</a>.</p>
          </>) : (<>
            <h2>{title} – živý prenos</h2>
            <p>{state === 'live' ? `Zápas ${title} sa práve hrá` : `Zápas ${title} sa začína ${longDay(m.st)} o ${hhmm(m.st)}`} v súťaži {lgName}. {m.stream ? 'Vysiela sa naživo registrovaným hráčom – stačí sa prihlásiť a prenos spustiť.' : 'Video k nemu nie je, naživo však sleduješ štatistiky a priebežné skóre.'} Ďalšie zápasy nájdeš na stránke <a href={leaguePathOf(m)}>{lgName}</a> alebo v <a href="/program/">programe prenosov</a>.</p>
            {formSentence ? <p>{formSentence}{teamH || teamA ? <> Program a výsledky klubov: {teamH ? <a href={teamPath(sport.slug, teamH.slug)}>{nh}</a> : null}{teamH && teamA ? ', ' : null}{teamA ? <a href={teamPath(sport.slug, teamA.slug)}>{na}</a> : null}.</> : null}</p> : null}
          </>)}
        </section>
        <section class="sec"><div class="sec-h"><h2>Časté otázky</h2></div><Faq items={faq} /></section>
      </div>
      <Side sports={sportCounts(v)} leagues={leagues(v, m.sp)} placement="detail-side" current={sport.slug} ticket={false} />
    </div>
  </div>
  {over ? null : <Stick m={m} label={watch} />}
</Base>
) : (
<Base title={`Zápas sa už skončil | ${BRAND}`} description="Tento zápas už nie je v ponuke." noindex ttl={300}>
  <div class="wrap">
    <section class="head"><h1>Zápas sa už skončil</h1><p class="lead">Tento zápas už nie je v ponuke prenosov. Pozri, čo sa hrá práve teraz alebo dnes.</p></section>
    <div class="cols"><div>
      <section class="sec"><div class="sec-h"><h2>Práve naživo</h2><a href="/teraz-nazivo/">Všetko ›</a></div><LeagueList items={v.live} now={now} placement="gone" live per={4} max={5} /></section>
      <Ticket placement="gone-bonus" wide />
    </div><Side sports={sportCounts(v)} leagues={leagues(v)} placement="gone-side" /></div>
  </div>
</Base>
)}
