---
import Base from '../../layouts/Base.astro';
import ResultList from '../../components/ResultList.astro';
import Side from '../../components/Side.astro';
import Crumbs from '../../components/Crumbs.astro';
import { getEnv, view, sportCounts, leagues } from '../../lib/page';
import { dayKey, addDays, longDay, weekday, shortDay } from '../../lib/text';
import { isDayKey, localDay } from '../../lib/results/time';
import { resultsConfig, resultsDb } from '../../lib/results/config';
import { rowsBetween } from '../../lib/results/store';
import { group } from '../../lib/results/status';
import { breadcrumbLd, BRAND } from '../../lib/seo';

export const prerender = false;
const env = getEnv();
const now = Date.now();
const raw = Astro.params.day ?? '';
const keys = Array.from({ length: 8 }, (_, i) => dayKey(addDays(now, -i)));
const key = !raw ? keys[0] : raw === 'vcera' ? keys[1] : isDayKey(raw) ? raw : '';
if (raw && key === keys[0]) return Astro.redirect('/vysledky/', 301);
if (raw && raw !== 'vcera' && key === keys[1]) return Astro.redirect('/vysledky/vcera/', 301);
if (!key || !keys.includes(key)) return Astro.rewrite('/404/');
const pathOf = (k: string) => (k === keys[0] ? '/vysledky/' : k === keys[1] ? '/vysledky/vcera/' : `/vysledky/${k}/`);
const rc = resultsConfig(env);
const db = resultsDb(env);
const rows = db ? await rowsBetween(db, ...localDay(key), rc.comps) : [];
const liveRows = rows.filter((r) => group(r.status) === 'live');
const done = rows.filter((r) => group(r.status) !== 'live' && r.status !== 'scheduled');
const later = rows.filter((r) => r.status === 'scheduled');
const ms = Date.parse(`${key}T12:00:00Z`);
const label = key === keys[0] ? 'dnes' : key === keys[1] ? 'včera' : longDay(ms);
const crumbs = [{ name: 'Domov', href: '/' }, { name: 'Výsledky', href: '/vysledky/' }, ...(key !== keys[0] ? [{ name: label }] : [])];
const v = await view(env);
---
<Base title={`Výsledky ${label} – Niké liga, Tipsport liga, Liga majstrov, NHL | ${BRAND}`} description={`Výsledky zápasov ${label}: ${done.length} odohraných${liveRows.length ? `, ${liveRows.length} práve prebieha` : ''}. Niké liga, Tipsport liga, európske poháre, top ligy, NHL a NBA.`} path={pathOf(key)} ld={[breadcrumbLd(crumbs)]} section="vysledky" ttl={key === keys[0] ? 60 : 900}>
  <div class="wrap">
    <Crumbs items={crumbs} />
    <section class="head">
      <div class="eyebrow"><span>{longDay(ms)}</span></div>
      <h1>Výsledky {label}</h1>
      <p class="lead">Skóre zápasov slovenských súťaží, európskych pohárov, top futbalových líg, NHL, NBA a Euroligy. Výsledok označíme ako konečný, až keď ho zdroj potvrdí.</p>
    </section>
    <nav class="days" aria-label="Deň">
      {[...keys].reverse().map((k, i, a) => { const d = Date.parse(`${k}T12:00:00Z`); const j = a.length - 1 - i; return <a href={pathOf(k)} aria-current={k === key ? 'page' : undefined}><small>{j === 0 ? 'dnes' : j === 1 ? 'včera' : weekday(d)}</small>{shortDay(d).replace(/\s/g, '')}</a>; })}
    </nav>
    <div class="cols">
      <div>
        {liveRows.length ? <section class="sec"><div class="sec-h"><h2>Práve sa hrá <span class="n live">{liveRows.length}</span></h2></div><ResultList rows={liveRows} comps={rc.comps} now={now} staleMs={rc.staleMs} /></section> : null}
        <section class="sec"><div class="sec-h"><h2>Odohrané <span class="n">{done.length}</span></h2></div><ResultList rows={done} comps={rc.comps} now={now} staleMs={rc.staleMs} empty={key === keys[0] ? 'Dnes sa ešte nedohral žiadny zápas sledovaných súťaží.' : 'V tento deň sa nehral žiadny zápas sledovaných súťaží.'} /></section>
        {later.length ? <section class="sec"><div class="sec-h"><h2>Ešte sa začne <span class="n">{later.length}</span></h2><a href="/program/">Program ›</a></div><ResultList rows={later} comps={rc.comps} now={now} staleMs={rc.staleMs} /></section> : null}
      </div>
      <Side sports={sportCounts(v)} leagues={leagues(v)} placement="results-side" />
    </div>
  </div>
</Base>
